{
  "name": "career-compass-backend",
  "version": "1.0.0",
  "description": "Backend API for the Career Compass platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check routes/progress.js && node --check services/supabaseService.js",
    "test:cloud": "node scripts/cloud-smoke.js",
    "test:integration": "node scripts/integration-smoke.js",
    "check:secrets": "node scripts/security-check.js"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "^4.0.0",
    "@azure/storage-blob": "^12.17.0",
    "@supabase/supabase-js": "^2.99.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "multer": "^2.0.2",
    "openai": "^6.16.0",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
