{
  "name": "SkillProgress",
  "type": "object",
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "technical",
        "soft",
        "domain"
      ]
    },
    "current_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "target_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "matched",
        "partial",
        "missing"
      ]
    },
    "importance": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "duration": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        }
      }
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": []
}